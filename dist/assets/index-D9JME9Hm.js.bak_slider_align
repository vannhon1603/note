      const pCutOx = project(activeCutX, 0, 0);
      ctx.fillStyle = "#ea580c";
      ctx.beginPath();
      ctx.arc(pCutOx.sx, pCutOx.sy, 4.5, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    } else {
    const cutW = Math.abs(f1(activeCutX) - f2(activeCutX));
