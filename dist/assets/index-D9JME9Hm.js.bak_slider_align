      const badgeText = "S(" + (Math.round(activeCutX * 10) / 10) + ") ≈ " + (Math.round(cutArea * 100) / 100);
      ctx.font = "bold 11px system-ui, sans-serif";
      const bw = ctx.measureText(badgeText).width + 12;
      ctx.fillStyle = "rgba(255, 255, 255, 0.92)";
      ctx.fillRect(topPt.sx - bw / 2, topPt.sy - 22, bw, 18);
      ctx.strokeStyle = "#d97706";
      ctx.lineWidth = 1;
      ctx.strokeRect(topPt.sx - bw / 2, topPt.sy - 22, bw, 18);
      ctx.fillStyle = "#b45309";
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";
      ctx.fillText(badgeText, topPt.sx, topPt.sy - 13);item._cutHandle = { x: topPt.sx - x, y: topPt.sy - y };ctx.beginPath();ctx.arc(topPt.sx, topPt.sy, 8, 0, Math.PI * 2);ctx.fillStyle = "#ffffff";ctx.fill();ctx.strokeStyle = "#d97706";ctx.lineWidth = 2.5;ctx.stroke();ctx.beginPath();ctx.arc(topPt.sx, topPt.sy, 3.5, 0, Math.PI * 2);ctx.fillStyle = "#d97706";ctx.fill();
    }

    // Mark current x position on Ox axis with indicator tick
    const pCutOx = project(activeCutX, 0, 0);
    ctx.fillStyle = "#ea580c";
    ctx.beginPath();
    ctx.arc(pCutOx.sx, pCutOx.sy, 4.5, 0, Math.PI * 2);
    ctx.fill();

    ctx.restore();
    } // end else
  }

  // ─── 7. Representative Slice dx for Revolutions ──────────────────
  if (showSlice && isRev) {
    const midX = activeCutX;
    const sR = f1(midX);
    ctx.save();
    if (isRevOx) {
      ctx.strokeStyle = "#06b6d4";
      ctx.lineWidth = 2.5;
