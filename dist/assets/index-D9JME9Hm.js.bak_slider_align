    const arcRadius = isRevOx ? Math.min(maxVal * 0.45, 1.2) : Math.min(nb * 0.45, 1.2);
    const arcX = isRevOx ? nb + 0.35 : 0;
    const arcY = isRevOx ? 0 : maxVal * 0.85;

