  if (isCross) {
    ctx.fillStyle = "#d97706"; ctx.fill();
    ctx.fillStyle = "#ffffff"; ctx.font = "bold 10px system-ui, sans-serif";
  } else {
    ctx.fillStyle = "rgba(241, 245, 249, 0.85)"; ctx.fill();
    ctx.strokeStyle = "rgba(203, 213, 225, 0.7)"; ctx.lineWidth = 0.8; ctx.stroke();
