function volumeSimpsons(fv,a,b,n){
  if(n%2!==0)n++;
  const h=(b-a)/n;
  let fa=fv(a);
  if(!isFinite(fa))fa=fv(a+1e-6*(b-a));
  let fb=fv(b);
  if(!isFinite(fb))fb=fv(b-1e-6*(b-a));
  let sum=(isFinite(fa)?fa:0)+(isFinite(fb)?fb:0);
  for(let i=1;i<n;i++){
    const x=a+i*h;
    let fx=fv(x);
    if(!isFinite(fx))fx=fv(x+1e-7*(b-a));
    if(!isFinite(fx))continue;
    sum+=(i%2===0?2:4)*fx;
  }
  return(h/3)*sum;
