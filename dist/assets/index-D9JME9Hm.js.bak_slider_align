    if (cutW > 0.001) {
      const cutPts = cutShape.map(pt => project(activeCutX, cutYm + pt.u, pt.v));
      ctx.beginPath();
      ctx.moveTo(cutPts[0].sx, cutPts[0].sy);
      for (let k = 1; k < cutPts.length; k++) ctx.lineTo(cutPts[k].sx, cutPts[k].sy);
