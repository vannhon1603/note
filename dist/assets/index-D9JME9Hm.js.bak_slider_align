  else if(axis==="oy"||axis==="sec-oy"){integrand=x=>2*Math.PI*Math.abs(x)*Math.abs(f1(x)-g2(x));}
  else if(axis==="sec-square"){integrand=x=>{const s=Math.abs(f1(x)-g2(x));return s*s;};}
