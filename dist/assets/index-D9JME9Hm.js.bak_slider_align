    ctx.closePath();
    ctx.fillStyle = "rgba(6, 182, 212, 0.16)";
    ctx.fill();
    ctx.strokeStyle = "rgba(6, 182, 212, 0.65)";
    ctx.lineWidth = 1.2;
    ctx.setLineDash([4, 3]);
    ctx.stroke();
    ctx.setLineDash([]);

